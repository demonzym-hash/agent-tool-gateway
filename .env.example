# PostgreSQL connection used by ATG Server.
DATABASE_URL=postgres://atg:atg@localhost:5432/atg

# Shared admin token for management APIs and the Web Console.
# Set a long random value before sharing an environment.
ADMIN_TOKEN=

# Secret used to encrypt sensitive Tool headers before storage.
# Required for Docker Compose and production mode.
SECRET_KEY=

# Optional outbound Tool egress controls.
# TOOL_ALLOWED_HOSTS is a comma-separated hostname allowlist.
TOOL_ALLOWED_HOSTS=
TOOL_ALLOW_HTTP=
TOOL_ALLOW_PRIVATE_NETWORK=

# Local service ports.
PORT=8080
LOG_LEVEL=info
ATG_PORT=8080
MOCK_PORT=9090
WEB_PORT=5173

# Local check/demo target URLs.
WEB_BASE_URL=http://localhost:5173
ATG_BASE_URL=http://localhost:8080
MOCK_BASE_URL=http://localhost:9090
