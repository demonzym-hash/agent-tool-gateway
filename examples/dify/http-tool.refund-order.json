{
  "name": "refund_order_via_atg",
  "description": "Call the ATG refund_order tool from Dify through HTTP.",
  "method": "POST",
  "url": "http://localhost:8080/api/v1/invoke/refund_order",
  "headers": {
    "Authorization": "Bearer {{ATG_API_KEY}}",
    "Content-Type": "application/json"
  },
  "body": {
    "order_id": "{{order_id}}",
    "amount": "{{amount}}",
    "reason": "{{reason}}"
  },
  "expected_success_status": 200,
  "approval_pending_status": 202
}
